@echo off
rem compile_glutcube.cmd -- build glutcube.exe with LINK-TIME imports of the
rem Mesa DLLs (libGLUT7.dll, MesaGL7.dll, libGLU7.dll), visible in PMDLL.
rem Run from Mesa-7.11.2\demos\glutcube\   Log: compile_glutcube.log
rem
rem Import libraries (lib\*_imp.a) are generated by emximp from the
rem *_imp.def files in the Mesa root; they map _glFoo -> DLL export glFoo.
rem glutcube.def sets  NAME GLUTCUBE WINDOWAPI  (PM application flag).

set MESA_ROOT=..\..\
set EMXOMFLD_TYPE=WLINK
set EMXOMFLD_LINKER=wl.exe
set EMXOMFLD_PRELINK=0

echo Mesa GLUT cube demo (link-time DLL imports) -- %DATE% %TIME% > compile_glutcube.log

echo === Step 1: import libraries === >> compile_glutcube.log
emximp -o %MESA_ROOT%lib\libGLUT7_imp.a %MESA_ROOT%libGLUT7_imp.def 2>&1 | tee -a compile_glutcube.log
emximp -o %MESA_ROOT%lib\MesaGL7_imp.a  %MESA_ROOT%MesaGL7_imp.def  2>&1 | tee -a compile_glutcube.log
emximp -o %MESA_ROOT%lib\libGLU7_imp.a  %MESA_ROOT%libGLU7_imp.def  2>&1 | tee -a compile_glutcube.log

echo === Step 2: Compiling glutcube.c === >> compile_glutcube.log
gcc -Wall -O2 -Zomf -c glutcube.c -o glutcube.o -I%MESA_ROOT%include 2>&1 | tee -a compile_glutcube.log
if errorlevel 1 ( echo FAILED step 2 >> compile_glutcube.log & goto :end )

echo === Step 3: Linking === >> compile_glutcube.log
gcc -Zomf -o glutcube.exe glutcube.def glutcube.o %MESA_ROOT%lib\libGLUT7_imp.a %MESA_ROOT%lib\MesaGL7_imp.a %MESA_ROOT%lib\libGLU7_imp.a -lm 2>&1 | tee -a compile_glutcube.log

echo. >> compile_glutcube.log
echo === Step 4: Import table === >> compile_glutcube.log
if exist glutcube.exe (
    wdump -i glutcube.exe 2>&1 | tee -a compile_glutcube.log
    echo Done: glutcube.exe >> compile_glutcube.log
    echo Done: glutcube.exe
) else (
    echo FAILED: glutcube.exe not produced >> compile_glutcube.log
    echo FAILED -- see compile_glutcube.log
)

:end
echo Log: compile_glutcube.log