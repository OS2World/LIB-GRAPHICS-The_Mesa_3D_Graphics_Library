# Makefile.os2 — build Mesa 7.11.2 classic swrast + OS/2 PM driver
#
# Run from the Mesa-7.11.2 root with:
#   make -f Makefile.os2
#
# Requires: GCC 9.2 (via ArcaOS ANPM), OS/2 Toolkit headers
#
# Outputs (relative to Mesa root):
#   obj_os2/*.o        — OMF object files
#   lib/MesaGL7.a      — static Mesa library (link against this)
#   dll/MesaGL7.dll    — OS/2 DLL

TOP = .

MESA_SRC    = $(TOP)/src/mesa
GLSL_SRC    = $(TOP)/src/glsl
INCLUDE     = $(TOP)/include
OS2_DRIVER  = $(MESA_SRC)/drivers/os2
OS2_COMPAT  = $(OS2_DRIVER)/os2_compat
OSMESA_DRIVER = $(MESA_SRC)/drivers/osmesa

CC   = gcc
CXX  = g++
AR   = ar
ARFLAGS = rcs

# OS/2 Toolkit include path — adjust if your toolkit is elsewhere
OS2TK = /usr/include

CFLAGS = -O2 -Wall -fno-builtin-sinf -fno-builtin-cosf -fno-builtin-sin -fno-builtin-cos -Zomf \
         -D__OS2__ -DBUILD_GL32 \
         -D_near= -D_far= -D_cdecl= -D_huge= -D_pascal= \
         -I$(OS2_COMPAT) \
         -I$(INCLUDE) \
         -I$(MESA_SRC) \
         -I$(MESA_SRC)/main \
         -I$(GLSL_SRC) \
         -I$(TOP)/src/mapi \
         -I$(OS2TK)

CXXFLAGS = $(CFLAGS) -fpermissive

# ---------------------------------------------------------------------------
# Source file lists
# ---------------------------------------------------------------------------

# OS/2 platform driver
OS2_SRCS = \
    $(OS2_DRIVER)/os2mesa.c \
    $(OS2_DRIVER)/os2mesa_math.c \
    $(OSMESA_DRIVER)/osmesa.c

# Mesa core — main/
