    $(GLSL_SRC)/lower_jumps.cpp \
    $(GLSL_SRC)/lower_mat_op_to_vec.cpp \
    $(GLSL_SRC)/lower_noise.cpp \
    $(GLSL_SRC)/lower_texture_projection.cpp \
    $(GLSL_SRC)/lower_variable_index_to_cond_assign.cpp \
    $(GLSL_SRC)/lower_vec_index_to_cond_assign.cpp \
    $(GLSL_SRC)/lower_vec_index_to_swizzle.cpp \
    $(GLSL_SRC)/lower_vector.cpp \
    $(GLSL_SRC)/opt_algebraic.cpp \
    $(GLSL_SRC)/opt_constant_folding.cpp \
    $(GLSL_SRC)/opt_constant_propagation.cpp \
    $(GLSL_SRC)/opt_constant_variable.cpp \
    $(GLSL_SRC)/opt_copy_propagation.cpp \
    $(GLSL_SRC)/opt_copy_propagation_elements.cpp \
    $(GLSL_SRC)/opt_dead_code.cpp \
    $(GLSL_SRC)/opt_dead_code_local.cpp \
    $(GLSL_SRC)/opt_dead_functions.cpp \
    $(GLSL_SRC)/opt_discard_simplification.cpp \
    $(GLSL_SRC)/opt_function_inlining.cpp \
    $(GLSL_SRC)/opt_if_simplification.cpp \
    $(GLSL_SRC)/opt_noop_swizzle.cpp \
    $(GLSL_SRC)/opt_redundant_jumps.cpp \
    $(GLSL_SRC)/opt_structure_splitting.cpp \
    $(GLSL_SRC)/opt_swizzle_swizzle.cpp \
    $(GLSL_SRC)/opt_tree_grafting.cpp \
    $(GLSL_SRC)/s_expression.cpp \
    $(GLSL_SRC)/ralloc.c \
    $(GLSL_SRC)/strtod.c

# Program (vertex/fragment programs)
PROGRAM_SRCS = \
    $(MESA_SRC)/program/arbprogparse.c \
    $(MESA_SRC)/program/lex.yy.c \
    $(MESA_SRC)/program/program_parse.tab.c \
    $(MESA_SRC)/program/program_parse_extra.c \
    $(MESA_SRC)/program/hash_table.c \
    $(MESA_SRC)/program/ir_to_mesa.cpp \
    $(MESA_SRC)/program/nvfragparse.c \
    $(MESA_SRC)/program/nvvertparse.c \
    $(MESA_SRC)/program/prog_cache.c \
    $(MESA_SRC)/program/prog_execute.c \
    $(MESA_SRC)/program/prog_instruction.c \
    $(MESA_SRC)/program/prog_noise.c \
    $(MESA_SRC)/program/prog_optimize.c \
    $(MESA_SRC)/program/prog_parameter.c \
    $(MESA_SRC)/program/prog_parameter_layout.c \
    $(MESA_SRC)/program/prog_print.c \
    $(MESA_SRC)/program/prog_statevars.c \
    $(MESA_SRC)/program/prog_uniform.c \
    $(MESA_SRC)/program/program.c \
    $(MESA_SRC)/program/programopt.c \
    $(MESA_SRC)/program/register_allocate.c \
    $(MESA_SRC)/program/sampler.cpp \
    $(MESA_SRC)/program/symbol_table.c

# mapi (GL dispatch table)
MAPI_SRCS = \
    $(TOP)/src/mapi/glapi/glapi.c \
    $(TOP)/src/mapi/glapi/glapi_dispatch.c \
    $(TOP)/src/mapi/glapi/glapi_entrypoint.c \
    $(TOP)/src/mapi/glapi/glapi_getproc.c \
    $(TOP)/src/mapi/glapi/glapi_nop.c

# u_current.c lives in src/mapi/mapi/, not src/mapi/glapi/ — needs its own rule
MAPI_UCUR_SRC = $(TOP)/src/mapi/mapi/u_current.c
MAPI_UCUR_OBJ = $(OBJ_DIR)/mapi_u_current.o

# ff_fragment_shader.cpp lives in mesa/main/ but is C++, MAIN_OBJS only handles .c
FF_FRAG_OBJ = $(OBJ_DIR)/main_ff_fragment_shader.o

# GLSL preprocessor (glcpp/) — subdirectory, needs its own pattern
GLCPP_SRC = $(GLSL_SRC)/glcpp
GLCPP_SRCS = \
    $(GLCPP_SRC)/glcpp-lex.c \
    $(GLCPP_SRC)/glcpp-parse.c \
    $(GLCPP_SRC)/pp.c
GLCPP_OBJS = $(patsubst $(GLCPP_SRC)/%.c,$(OBJ_DIR)/glcpp_%.o,$(GLCPP_SRCS))

# ---------------------------------------------------------------------------
# Object file derivation
# ---------------------------------------------------------------------------

OBJ_DIR = obj_os2

OS2_OBJS    = $(OBJ_DIR)/os2mesa.o $(OBJ_DIR)/os2mesa_math.o $(OBJ_DIR)/osmesa.o
MAIN_OBJS   = $(patsubst $(MESA_SRC)/main/%.c,$(OBJ_DIR)/main_%.o,$(MAIN_SRCS))
MATH_OBJS   = $(patsubst $(MESA_SRC)/math/%.c,$(OBJ_DIR)/math_%.o,$(MATH_SRCS))
VBO_OBJS    = $(patsubst $(MESA_SRC)/vbo/%.c,$(OBJ_DIR)/vbo_%.o,$(VBO_SRCS))
TNL_OBJS    = $(patsubst $(MESA_SRC)/tnl/%.c,$(OBJ_DIR)/tnl_%.o,$(TNL_SRCS))
SWSETUP_OBJS = $(patsubst $(MESA_SRC)/swrast_setup/%.c,$(OBJ_DIR)/swsetup_%.o,$(SWSETUP_SRCS))
SWRAST_OBJS = $(patsubst $(MESA_SRC)/swrast/%.c,$(OBJ_DIR)/swrast_%.o,$(SWRAST_SRCS))
COMMON_OBJS = $(patsubst $(MESA_SRC)/drivers/common/%.c,$(OBJ_DIR)/drv_%.o,$(COMMON_SRCS))
PROGRAM_OBJS = $(patsubst $(MESA_SRC)/program/%.c,$(OBJ_DIR)/prog_%.o,\
               $(filter %.c,$(PROGRAM_SRCS))) \
               $(patsubst $(MESA_SRC)/program/%.cpp,$(OBJ_DIR)/prog_%.o,\
               $(filter %.cpp,$(PROGRAM_SRCS)))
GLSL_OBJS   = $(patsubst $(GLSL_SRC)/%.cpp,$(OBJ_DIR)/glsl_%.o,\
              $(filter %.cpp,$(GLSL_SRCS))) \
              $(patsubst $(GLSL_SRC)/%.c,$(OBJ_DIR)/glsl_%.o,\
              $(filter %.c,$(GLSL_SRCS)))
MAPI_OBJS   = $(patsubst $(TOP)/src/mapi/glapi/%.c,$(OBJ_DIR)/mapi_%.o,$(MAPI_SRCS))

ALL_OBJS = $(OS2_OBJS) $(MAIN_OBJS) $(MATH_OBJS) $(VBO_OBJS) $(TNL_OBJS) \
           $(SWSETUP_OBJS) $(SWRAST_OBJS) $(COMMON_OBJS) $(PROGRAM_OBJS) \
           $(GLSL_OBJS) $(GLCPP_OBJS) $(MAPI_OBJS) $(MAPI_UCUR_OBJ) \
           $(FF_FRAG_OBJ)

LIB_OUT = $(TOP)/lib/MesaGL7.a
DLL_OUT = $(TOP)/dll

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------

.PHONY: all static dll clean

all: static

static: $(OBJ_DIR) $(LIB_OUT)

dll: $(OBJ_DIR)
	gcc -Zomf -Zdll -Zmap=dll/MesaGL7 -o dll/MesaGL7.dll @mesagl.rsp MesaGL7.def -lstdc++ -los2 -lm
	emximp -o lib/MesaGL7_imp.a MesaGL7_imp.def

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(LIB_OUT): $(ALL_OBJS)
	$(AR) $(ARFLAGS) $@ $^

# OS/2 driver (explicit rules — sources live in the driver subdirectory)
$(OBJ_DIR)/os2mesa.o: $(OS2_DRIVER)/os2mesa.c $(OS2_DRIVER)/os2mesa.h $(OS2_DRIVER)/os2mesadef.h $(OS2_DRIVER)/os2_config.h
	$(CC) $(CFLAGS) -c -o $@ $<

$(OBJ_DIR)/os2mesa_math.o: $(OS2_DRIVER)/os2mesa_math.c
	$(CC) $(CFLAGS) -c -o $@ $<

# OSMesa: off-screen rendering into a caller-supplied memory buffer
$(OBJ_DIR)/osmesa.o: $(OSMESA_DRIVER)/osmesa.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/main/
$(OBJ_DIR)/main_%.o: $(MESA_SRC)/main/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/math/
$(OBJ_DIR)/math_%.o: $(MESA_SRC)/math/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/vbo/
$(OBJ_DIR)/vbo_%.o: $(MESA_SRC)/vbo/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/tnl/
$(OBJ_DIR)/tnl_%.o: $(MESA_SRC)/tnl/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/swrast_setup/
$(OBJ_DIR)/swsetup_%.o: $(MESA_SRC)/swrast_setup/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/swrast/
$(OBJ_DIR)/swrast_%.o: $(MESA_SRC)/swrast/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/drivers/common/
$(OBJ_DIR)/drv_%.o: $(MESA_SRC)/drivers/common/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# mesa/program/
$(OBJ_DIR)/prog_%.o: $(MESA_SRC)/program/%.c
	$(CC) $(CFLAGS) -c -o $@ $<
$(OBJ_DIR)/prog_%.o: $(MESA_SRC)/program/%.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# src/glsl/
$(OBJ_DIR)/glsl_%.o: $(GLSL_SRC)/%.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<
$(OBJ_DIR)/glsl_%.o: $(GLSL_SRC)/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# src/mapi/glapi/
$(OBJ_DIR)/mapi_%.o: $(TOP)/src/mapi/glapi/%.c
	$(CC) $(CFLAGS) -I$(TOP)/src/mapi -c -o $@ $<

# mesa/main/ff_fragment_shader.cpp (C++ — not matched by MAIN_OBJS .c pattern)
$(FF_FRAG_OBJ): $(MESA_SRC)/main/ff_fragment_shader.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# src/glsl/glcpp/ (subdirectory — not matched by GLSL_OBJS pattern)
$(OBJ_DIR)/glcpp_%.o: $(GLCPP_SRC)/%.c
	$(CC) $(CFLAGS) -I$(GLSL_SRC) -c -o $@ $<

# src/mapi/mapi/u_current.c (defines _glapi_Context / _glapi_Dispatch)
# -DMAPI_MODE_UTIL: skips table.h/mapi_tmp.h (which need MAPI_ABI_HEADER from
# the full Mesa build system); uses __glapi_noop_table from glapi_entrypoint.o
$(MAPI_UCUR_OBJ): $(MAPI_UCUR_SRC)
	$(CC) $(CFLAGS) -I$(TOP)/src/mapi -DMAPI_MODE_UTIL -c -o $@ $<

clean:
	rm -f $(OBJ_DIR)/*.o
	rm -f $(LIB_OUT)
	rm -f $(DLL_OUT)/MesaGL7.dll
	rm -f $(DLL_OUT)/MesaGL7.map
